# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # SERVER ONLY — never expose to client

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxx
RAZORPAY_KEY_SECRET=<secret>
RAZORPAY_WEBHOOK_SECRET=<webhook-secret>
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxx      # public — used in client checkout

# ── Notifications ─────────────────────────────────────────────────────────────
MSG91_AUTH_KEY=<msg91-auth-key>                # OTP + transactional SMS
MSG91_OTP_TEMPLATE_ID=<msg91-flow-id>          # DLT-approved OTP flow id — REQUIRED with MSG91_AUTH_KEY (empty id is rejected by MSG91)
WHATSAPP_API_KEY=<gupshup-or-interakt-key>     # WhatsApp Business API (legacy stub gate)
# ── WhatsApp rails (S0.5) — stub (no bill) until a driver + its credentials are set ──
WHATSAPP_DRIVER=stub                           # meta_cloud | interakt | stub
WHATSAPP_PHONE_NUMBER_ID=                      # meta_cloud
WHATSAPP_ACCESS_TOKEN=                         # meta_cloud (system-user token)
WHATSAPP_APP_SECRET=                           # meta_cloud webhook HMAC (X-Hub-Signature-256)
WHATSAPP_VERIFY_TOKEN=                         # meta_cloud GET webhook challenge
INTERAKT_API_KEY=                              # interakt (Basic)
INTERAKT_WEBHOOK_SECRET=                       # interakt shared secret header (x-interakt-secret)
NEXT_PUBLIC_WHATSAPP_NUMBER=                   # business number, E.164 digits, for the wa.me link
RESEND_API_KEY=re_xxxx                         # Transactional email
# Sender for outbound email. Without it, falls back to onboarding@resend.dev,
# which only delivers to the Resend account owner — set after verifying the
# amclub.in domain (DKIM) in the Resend dashboard.
RESEND_FROM=AMClub <notify@amclub.in>

# ── KYC / verification APIs ───────────────────────────────────────────────────
KYC_API_KEY=<surepass-or-signzy-key>           # GSTIN, Udyam, PAN, bank-account verification

# ── Voice RFQ (Phase 8b) — both stub (log "would …", no paid call) when unset ─
SARVAM_API_KEY=<sarvam-subscription-key>       # speech-to-text-translate (saaras:v3)
OPENROUTER_API_KEY=<openrouter-key>            # requirement parse (one cheap LLM call)
VOICE_PARSE_MODEL=google/gemini-2.5-flash-lite # optional override (OpenRouter model id)
SARVAM_COST_PAISE_PER_MIN=50                   # ai_invocations cost estimate; unset → null
OPENROUTER_USD_INR_PAISE=8800                  # paise per USD for OpenRouter usage.cost (default 8800)
# Task-class model router (ADR-008). Tier -> OpenAI-compatible model id (OpenRouter
# namespace). Unset -> defaults in apps/web/lib/agent/router.ts. VOICE_PARSE_MODEL,
# when set, still overrides the routine tier for the voice parser.
AGENT_MODEL_LIVE=google/gemini-2.5-flash-lite
AGENT_MODEL_ROUTINE=google/gemini-2.5-flash-lite
AGENT_MODEL_REASONING=qwen/qwen3-235b-a22b
AGENT_MODEL_FRONTIER=anthropic/claude-sonnet-4.5

# ── Encryption ────────────────────────────────────────────────────────────────
# 32-byte key as 64 hex chars. Encrypts bank account numbers at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COLUMN_ENCRYPTION_KEY=<64-hex-char-key>        # SERVER ONLY — required in production

# ── Monitoring ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@sentry.io/xxxx
SENTRY_DSN=https://xxxx@sentry.io/xxxx
SENTRY_AUTH_TOKEN=<sentry-auth-token>          # For source map uploads in CI
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
# E0 / U2 — show "₹X for members" lines only once memberships exist and checkout applies them (default off)
NEXT_PUBLIC_MEMBER_PRICING_ENABLED=false
EXPO_PUBLIC_MEMBER_PRICING_ENABLED=false

# ── Cron auth ─────────────────────────────────────────────────────────────────
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` on scheduled hits.
# REQUIRED in production: without it, verifyCron rejects every cron and
# auto-cancel/auto-accept/rfq-expire/reconcile/payouts silently stop running.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=<random-secret>                    # SERVER ONLY — set in Vercel too

# ── Rate limiting (Upstash Redis REST) ────────────────────────────────────────
# Find these in: Upstash console → your Redis DB → REST API. When unset, rate
# limiting is disabled (allow-all) — set both in production.
UPSTASH_REDIS_REST_URL=https://<db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<rest-token>          # SERVER ONLY

# ── CAPTCHA (Cloudflare Turnstile) ────────────────────────────────────────────
# Site key is public (renders the widget). The matching SECRET key goes in the
# Supabase dashboard (Auth → Settings → CAPTCHA), NOT here. When the site key is
# unset, the captcha widget is skipped (dev/local).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<turnstile-site-key>

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Feature flags ─────────────────────────────────────────────────────────────
# COUPONS_ENABLED: master switch for the Phase-6 coupon path (checkout input +
# money branch + /admin/coupons + /coupons/validate). Default OFF — all coupon
# code stays in the repo, dormant. Set to "true" to restore the full behaviour.
COUPONS_ENABLED=false
# MART_ENABLED: master switch for AMC Mart (goods mode) — pages, nav, /api/v1/mart/*
# and the mobile tab (delivered via /api/v1/profile/me). DARK BUILD: keep false in
# prod until the Launch Gate (docs/MART_DESIGN.md §8); true in local/preview.
MART_ENABLED=false
# CATALOG_AGENT_MODEL: OpenRouter model for the Mart Catalog Agent (vision-capable;
# default google/gemini-2.5-flash-lite). Uses OPENROUTER_API_KEY; stubs when unset.
CATALOG_AGENT_MODEL=
# PAYOUT_AUTO_RELEASE: founder control gate on provider payouts. Default OFF —
# every payout is created 'held'; money moves ONLY when an admin releases it
# from /admin/payouts (release settles immediately). Set to "true" to restore
# the automatic buyer-acceptance → T+2 → daily-cron flow.
PAYOUT_AUTO_RELEASE=false
# AMC Mart M1 — Group-Buy Agent title/pitch polish (OpenRouter; defaults to CATALOG_AGENT_MODEL, stub without OPENROUTER_API_KEY)
GROUP_BUY_AGENT_MODEL=
# AGENT_ENABLED: master switch for every /api/v1/agent/* surface (DESIGN.md §8.6,
# ADR-008/009). Default OFF — the whole agent programme ships dark.
AGENT_ENABLED=false

# ── Agent programme S0.1 (ADR-009) — all optional in the dark build ───────────
# Delegated identity: mint the run-bound JWT with the project's JWT secret
# (Supabase dashboard -> Settings -> API -> JWT Secret). Required to enable.
SUPABASE_JWT_SECRET=<supabase-jwt-secret>
# The always-on runtime (apps/agent-runtime on Fly.io, region bom): its base URL
# and the HMAC secret the token endpoint trusts / the decision route calls back with.
AGENT_RUNTIME_URL=<https://amc-agent-runtime.fly.dev>
AGENT_RUNTIME_SECRET=<generate: openssl rand -hex 32>
# LLM gateway (OpenAI-compatible). Absent key -> agent-core stub mode (no bill).
AGENT_LLM_BASE_URL=https://openrouter.ai/api/v1
AGENT_LLM_API_KEY=<gateway-key; falls back to OPENROUTER_API_KEY>
AGENT_EMBED_BASE_URL=
AGENT_MODEL_EMBEDDING=openai/text-embedding-3-small
# Budget caps (paise). Unset -> agent_settings, else registry defaults (2000/5000/500000).
AGENT_BUDGET_RUN_PAISE=
AGENT_BUDGET_USER_DAY_PAISE=
AGENT_BUDGET_MONTH_PAISE=
