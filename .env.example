# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # SERVER ONLY — never expose to client

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxx
RAZORPAY_KEY_SECRET=<secret>
RAZORPAY_WEBHOOK_SECRET=<webhook-secret>
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxx      # public — used in client checkout

# ── Notifications ─────────────────────────────────────────────────────────────
MSG91_AUTH_KEY=<msg91-auth-key>                # OTP + transactional SMS
WHATSAPP_API_KEY=<gupshup-or-interakt-key>     # WhatsApp Business API
RESEND_API_KEY=re_xxxx                         # Transactional email

# ── KYC / verification APIs ───────────────────────────────────────────────────
KYC_API_KEY=<surepass-or-signzy-key>           # GSTIN, Udyam, PAN, bank-account verification

# ── Monitoring ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@sentry.io/xxxx
SENTRY_DSN=https://xxxx@sentry.io/xxxx
SENTRY_AUTH_TOKEN=<sentry-auth-token>          # For source map uploads in CI
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
