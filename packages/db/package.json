{
  "name": "@amclub/db",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:apply-rls": "tsx src/scripts/apply-rls.ts",
    "db:seed": "tsx src/seed.ts",
    "db:test-rls": "tsx src/scripts/test-rls.ts",
    "db:setup": "pnpm db:migrate && pnpm db:apply-rls && pnpm db:seed",
    "lint": "eslint src"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "drizzle-orm": "^0.45.0",
    "postgres": "^3.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.63.0"
  }
}
